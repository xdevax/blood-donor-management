# ==========================================================
# ENVIRONMENT VARIABLE TEMPLATE
# Blood Donor Management System - Backend
# ----------------------------------------------------------
# This file IS committed to Git. It contains NO real secrets.
#
# SETUP:
#   1. Copy this file and rename the copy to ".env"
#   2. Replace the placeholder values with your own
#   3. Never commit your ".env" file
# ==========================================================

# Port the Express server listens on.
# Locally this is 5000. In production the cloud host
# (Render) supplies its own port automatically.
PORT=5000

# MongoDB Atlas connection string.
# Get this from: Atlas Dashboard > Connect > Drivers
# Replace <username>, <password>, <cluster> and <dbname>
# with your own values. The example below is NOT a real database.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority