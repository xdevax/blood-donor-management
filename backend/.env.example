# Copy this file to .env and fill in your real values.
# Command (PowerShell, from backend/):  Copy-Item .env.example .env

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string
# Get it from: Atlas -> Cluster -> Connect -> Drivers -> Node.js
# Replace <username>, <password> and <cluster-url> with your own values.
# Use an alphanumeric password to avoid URL-encoding issues.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/blood_donor_db?retryWrites=true&w=majority&appName=BloodDonorCluster